{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jelly Voice & Notes",
  "mainBinaryName": "jelly-voice-notes",
  "version": "0.1.0",
  "identifier": "app.jellyvoicenotes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Jelly Voice & Notes",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      },
      {
        "label": "pill",
        "url": "pill.html",
        "title": "Jelly",
        "width": 460,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false,
        "focusable": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/menubar-template.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": true,
      "tooltip": "Jelly Voice & Notes"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.4"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}